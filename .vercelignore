# Vercel uses this instead of .gitignore when it exists, so it must also cover the
# directories .gitignore was handling — the first deploy uploaded .env despite being
# gitignored, and the build logged "Detected .env file".
node_modules
.next
.git

# Never ship local secrets. Production values come from Vercel's own env store; an uploaded
# .env would put the localhost:5433 dev credentials inside the deployment bundle.
.env
.env.*
# Local credentials notes (e.g. .demo-credentials.txt, untracked): not an .env name, so the
# two lines above let it through — the CLI uploads the working tree, not the git commit.
*credentials*

# Not part of the running app.
.agents
.claude
e2e
test-results
playwright-report
docs
tmp-*

# Оба каталога есть в .gitignore, но Vercel читает НЕ его — а без этих строк выкатка
# уносила бы в бандл 12 МБ скрейпа поставщиков и демо-страницу чужой платформы.
# Тот же класс промаха, что и с .env в шапке файла, только крупнее и заметнее.
Dataset
prototype-design
