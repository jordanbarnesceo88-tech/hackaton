DATABASE_URL="postgresql://rrp:rrp_dev_password@localhost:5433/robotization_roi"

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=

# Production URL (e.g. https://example.com). Optional if the host auto-detects; set it for
# self-hosted deployments behind a fixed domain so auth callback URLs are correct.
# В docker compose AUTH_URL намеренно не передаётся: в auth.ts стоит trustHost: true, и адрес
# берётся из запроса, поэтому вход работает и по localhost, и по IP.
AUTH_URL=

# Пароли демо-аккаунтов, которые создаёт сев (`npm run db:seed`; в Docker — сервис migrate):
# demo@demo.local — роль «пользователь», admin@demo.local — роль «администратор».
# Если переменная не задана, берутся пароли по умолчанию из README: demo-user-2026 и
# demo-admin-2026. На стенде, доступном извне, задайте свои.
# Строки закомментированы нарочно: пустое значение не должно превратиться в пустой пароль.
# DEMO_USER_PASSWORD=demo-user-2026
# DEMO_ADMIN_PASSWORD=demo-admin-2026

# Токен для записи через API v1 без браузерной сессии (интеграции с WMS/ERP/1С, ТЗ §3.8):
# заголовок `Authorization: Bearer <токен>`. Не задан — вход по токену выключен, и запись
# доступна только администратору, вошедшему в браузере. Сгенерировать: openssl rand -hex 32
# ADMIN_API_TOKEN=
