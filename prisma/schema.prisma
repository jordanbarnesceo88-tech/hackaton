generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Industry {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  facilityTypes FacilityType[]
}

model FacilityType {
  id               String                 @id @default(cuid())
  slug             String                 @unique
  name             String
  isGeneric        Boolean                @default(false)
  industryId       String
  industry         Industry               @relation(fields: [industryId], references: [id])
  categories       FacilityTypeCategory[]
  facilityExamples FacilityExample[]
}

model SolutionCategory {
  id String @id @default(cuid())

  // slug was unique PER facility type while a category belonged to one. It no longer does:
  // a category is a global catalogue of solution kinds ("AMR", "AS/RS", "паллетайзер"), and
  // applicability moved to FacilityTypeCategory. Keeping the per-type shape would have meant
  // re-creating every category for every one of ~45 facility types and duplicating each
  // solution class into all of them.
  slug          String                 @unique
  name          String
  description   String
  solutions     Solution[]
  facilityTypes FacilityTypeCategory[]
}

/// Which kinds of solution apply to which facility type. Explicit rather than implied: a
/// palletiser does not belong in a hospital ward, and a link that says otherwise lies to the
/// user on the one screen the product exists for.
model FacilityTypeCategory {
  facilityTypeId String
  facilityType   FacilityType     @relation(fields: [facilityTypeId], references: [id], onDelete: Cascade)
  categoryId     String
  category       SolutionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order          Int              @default(0)

  @@id([facilityTypeId, categoryId])
  @@index([categoryId])
}

enum SolutionSource {
  SEED
  ORGANIZER
  PARSED
}

enum CapacityBasis {
  PER_HOUR_FLOW
  PER_DAY_FLOW
  CONCURRENT_STOCK
}

model Solution {
  id                 String           @id @default(cuid())
  name               String
  vendor             String
  solutionCategoryId String
  solutionCategory   SolutionCategory @relation(fields: [solutionCategoryId], references: [id])
  priceUsd           Float
  priceEstimated     Boolean          @default(false)
  priceLowUsd        Float?
  priceHighUsd       Float?
  priceBasis         String?

  /// A class of solution rather than a specific model — a kind of machine, given as ranges
  /// instead of exact figures. The UI must say so: a class quoted as if it were a product
  /// with a real price is exactly the fabrication the provenance rules forbid.
  isClass            Boolean          @default(false)
  /// Throughput range, mirroring the price range. The midpoint lives in capacityPerUnit, so
  /// the engine consumes a class through the same toSolutionCapacity() as a vendor model.
  capacityLow        Float?
  capacityHigh       Float?

  capacityPerUnit    Float
  capacityUnit       String
  capacityBasis      CapacityBasis    @default(PER_DAY_FLOW)
  maintenanceUsdYear Float
  energyUsdYear      Float
  licensingUsdYear   Float
  specs              Json
  source             SolutionSource   @default(SEED)
  sourceUrl          String?
  lastVerified       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  savedAnalyses      SavedAnalysis[]

  @@unique([solutionCategoryId, name])
}

model FacilityExample {
  id             String       @id @default(cuid())
  name           String
  facilityTypeId String
  facilityType   FacilityType @relation(fields: [facilityTypeId], references: [id])
  params         Json
}

model Assumption {
  id          String  @id @default(cuid())
  key         String  @unique
  label       String
  value       Float
  unit        String?
  description String?
  order       Int     @default(0)
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  name          String?
  createdAt     DateTime        @default(now())
  savedAnalyses SavedAnalysis[]
}

model SavedAnalysis {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  facilityTypeSlug String
  solutionId       String
  // Restrict, not Cascade: a user's saved analysis is their data, and deleting a solution must
  // not silently take it with them. Without any relation at all, seed.ts's prune could delete a
  // renamed product and leave the analysis pointing at nothing — the report then 404s with no
  // explanation. Restrict turns that into a loud failure at the point of deletion instead.
  solution         Solution @relation(fields: [solutionId], references: [id], onDelete: Restrict)
  params           Json
  assumptions      Json
  results          Json
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([solutionId])
}

// Fixed-window rate-limit counter for auth endpoints (login/signup). DB-backed so it works on
// both a single Docker instance and serverless/multi-instance. `key` is e.g. "signup:ip:<ip>" or
// "login:<email>:<ip>"; `windowStart` is reset when the window elapses.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}
