node_modules
.next
.git
# Паттерн `.env` НЕ покрывает `.env.local` и `.env.deploy` — в последнем лежат боевые
# AUTH_SECRET, DATABASE_URL и NEON_*. `COPY . .` в Dockerfile запекал их в слой build-стадии:
# финальный образ чист, но запушенный или закешированный builder нёс живые креды.
# Форма повторяет .vercelignore, где это изначально сделано верно.
.env
.env.*
!.env.example
npm-debug.log
Dockerfile
.dockerignore

# Не часть работающего приложения — тот же список, что в .vercelignore. Dataset (скрейп
# поставщиков, ~12 МБ) и prototype-design (чужая демо-страница) раздували контекст сборки и
# слой `COPY . .`. Рантайм не читает ни одного файла из этих каталогов: данные для сева лежат в
# lib/data и scripts/seed-data — их исключать НЕЛЬЗЯ, на них стоит сервис migrate.
e2e
test-results
playwright-report
Dataset
prototype-design
tmp-*
docs
# Кеш инкрементальной проверки типов с машины разработчика и настройки агента — к сборке
# отношения не имеют.
*.tsbuildinfo
.claude
